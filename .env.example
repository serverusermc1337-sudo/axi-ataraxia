# Discord Developer Portal → Application → Bot
DISCORD_TOKEN=
# Application → General Information → Application ID
DISCORD_CLIENT_ID=
# Server Ataraxia → Rechtsklick → Server-ID kopieren (Entwicklermodus an)
DISCORD_GUILD_ID=

# Optional. Ohne Schlüssel gehen /ki, /anpassen und /optimieren nicht.
XAI_API_KEY=
AI_MODEL=grok-4.5

# Ordner für die Datenbank. Im Container bleibt das /data.
DATA_DIR=./data

# Web-Einstellung auf Port 8787. Mindestens 8 Zeichen, sonst bleibt sie aus.
WEB_PASSWORD=
WEB_PORT=8787
